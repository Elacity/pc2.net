{
  "name": "elacity-health",
  "title": "Health & Support",
  "version": "1.0.0",
  "role": "system",
  "description": "Run a local self-test on your PC2 node. Checks the database, transports, IPFS cluster, Lit/Chipotle config, supernode reachability, WASM runtimes, and update channel. Nothing leaves your machine.",
  "author": {
    "name": "Elacity Labs",
    "url": "https://ela.city"
  },
  "license": "proprietary",
  "icon": "icon.svg",
  "iconDataUrl": "data:image/svg+xml;base64,",
  "entry": "index.html",
  "type": "web",

  "capabilities": {
    "network": true,
    "ipc": [],
    "api_endpoints": [
      "GET /api/diagnose",
      "GET /whoami",
      "GET /api/support/report/policy",
      "POST /api/support/report/preview",
      "GET /api/metrics/snapshot"
    ],
    "postMessage_events": {
      "sends": [],
      "receives": []
    }
  },

  "requirements": {
    "minVersion": "1.2.7"
  },

  "display": {
    "maximize": false,
    "resizable": true,
    "titlebar": true,
    "taskbar": true,
    "width": 880,
    "height": 720
  },

  "distribution": {
    "channel": "stable"
  },

  "category": "system",
  "system": true
}
