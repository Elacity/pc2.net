{
  "name": "ddrm-renderer",
  "version": "1.1.2",
  "description": "AES-GCM decrypt + render (image/text/PDF/code/EPUB/CBZ) for dDRM content. 1.1.2 adds EPUB copy-lockdown (user-select:none, print blocked, drag-save blocked), asterism styling, paged-mode scaffolding.",
  "target": "wasm32-wasip1",
  "binary": "ddrm-renderer.wasm",
  "sha256": "329c8a4614207d1aad47391519571594e0dbc2e318e8ef8be5a9007a196aeb9f",
  "capabilities": [
    "drm:decrypt",
    "drm:render",
    "drm:encrypt"
  ],
  "provider_operations": [
    "drm:decrypt",
    "drm:render",
    "drm:encrypt-content"
  ],
  "supported_mime_types": [
    "image/jpeg",
    "image/png",
    "image/webp",
    "image/gif",
    "text/plain",
    "text/markdown",
    "text/html",
    "application/pdf",
    "application/epub+zip",
    "application/vnd.comicbook+zip",
    "application/x-cbz",
    "application/javascript",
    "application/json",
    "application/xml",
    "application/x-yaml",
    "application/toml",
    "application/x-sh",
    "text/x-python",
    "text/x-rust",
    "text/x-c",
    "text/x-go",
    "text/x-typescript",
    "text/x-java",
    "text/css"
  ],
  "render_tiers": {
    "pixel-lock": "image/*, application/pdf, application/vnd.comicbook+zip, text/x-* (source code)",
    "html-lock": "application/epub+zip (reflowable; sanitized XHTML with forensic watermark)"
  },
  "memfs": {
    "input": [
      "/input/command.json",
      "/input/encrypted.bin",
      "/input/plaintext.bin"
    ],
    "output": [
      "/output/result.json",
      "/output/rendered.bin",
      "/output/decrypted.bin",
      "/output/encrypted.bin"
    ]
  },
  "runtime_compatibility": {
    "wasi_preview": 1,
    "entry": "_start",
    "capsule_type": "wasm"
  }
}
